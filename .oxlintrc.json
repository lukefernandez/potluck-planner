{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "react", "nextjs", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "builtin": true,
    "browser": true,
    "es2022": true
  },
  "ignorePatterns": [".next", ".sst", "sst-env.d.ts"],
  "overrides": [
    {
      "files": ["sst.config.ts"],
      "rules": {
        "typescript/triple-slash-reference": "off"
      }
    }
  ],
  "rules": {
    "react/exhaustive-deps": "warn"
  }
}
